{
  "name": "cameras",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "dev": "node scripts/ensure-husky.mjs && yarn build:vcam && tauri dev --features canon",
    "dev:vite": "vite",
    "build:vcam": "cd src-tauri && cargo build -p vcam-source",
    "build:vcam:release": "cd src-tauri && cargo build -p vcam-source --release",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "yarn oxlint --deny-warnings --report-unused-disable-directives",
    "format": "oxfmt --write -c .oxfmtrc.json",
    "typecheck": "tsc -b --noEmit",
    "test": "node scripts/ensure-husky.mjs && vitest run --project unit --passWithNoTests",
    "test:visual": "vitest run --project visual",
    "prepare": "husky",
    "setup:hooks": "node scripts/ensure-husky.mjs",
    "format:check": "oxfmt --check -c .oxfmtrc.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^28",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/browser": "^4.0.18",
    "@vitest/browser-playwright": "^4.0.18",
    "eslint": "10",
    "eslint-plugin-unicorn": "^79.0.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^17.0.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "playwright": "^1.58.2",
    "typescript": "^7.0.0",
    "vite": "^6.1.0",
    "vitest": "^4.0.18",
    "vitest-browser-react": "^2.0.5"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix --deny-warnings --report-unused-disable-directives",
      "oxfmt --write"
    ],
    "*.{js,json,md,yml,yaml,jsonc}": [
      "oxfmt --write"
    ],
    "*.rs": [
      "rustfmt --edition 2021"
    ]
  },
  "dependenciesMeta": {
    "esbuild": {
      "built": true
    }
  }
}
